[
  {
    "name": "suspend-on-powersave",
    "bus": "session",
    "sender": "org.gnome.Mutter.DisplayConfig",
    "interface": "org.gnome.Mutter.DisplayConfig",
    "property": "PowerSaveMode",
    "operator": ">",
    "expected_value": "0",
    "argv": ["systemctl", "suspend"]
  },
  {
    "name": "on-lock",
    "bus": "system",
    "sender": "org.freedesktop.login1",
    "interface": "org.freedesktop.login1.Session",
    "property": "LockedHint",
    "operator": "==",
    "expected_value": "true",
    "only_on_change": true,
    "debounce_ms": 500,
    "argv": ["sh", "-c", "playerctl -a -i GSConnect pause; dconf write /org/gnome/shell/extensions/caffeine/cli-toggle false; gdbus call --session --dest org.gnome.Shell --object-path /dev/galets/gkr --method dev.galets.gkr.reset"]
  },
  {
    "name": "on-unlock",
    "bus": "system",
    "sender": "org.freedesktop.login1",
    "interface": "org.freedesktop.login1.Session",
    "property": "LockedHint",
    "operator": "==",
    "expected_value": "false",
    "only_on_change": true,
    "debounce_ms": 500,
    "argv": ["sh", "-c", "playerctl play; dconf write /org/gnome/shell/extensions/caffeine/cli-toggle true"]
  }
]
