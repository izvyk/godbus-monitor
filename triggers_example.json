[
  {
    "name": "on-lock",
    "bus": "system",
    "sender": "org.freedesktop.login1",
    "interface": "org.freedesktop.login1.Session",
    "property": "LockedHint",
    "operator": "==",
    "expected_value": "true",
    "only_on_change": true,
    "debounce_ms": 500,
    "argv": ["sh", "-c", "playerctl -a -i GSConnect pause; rm -f \"$XDG_RUNTIME_DIR/caffeine-was-enabled\"; if [ \"$(dconf read /org/gnome/shell/extensions/caffeine/cli-toggle)\" = true ]; then touch \"$XDG_RUNTIME_DIR/caffeine-was-enabled\"; fi; dconf write /org/gnome/shell/extensions/caffeine/cli-toggle false"]
  },
  {
    "name": "on-unlock",
    "bus": "system",
    "sender": "org.freedesktop.login1",
    "interface": "org.freedesktop.login1.Session",
    "property": "LockedHint",
    "operator": "==",
    "expected_value": "false",
    "only_on_change": true,
    "debounce_ms": 500,
    "argv": ["sh", "-c", "if [ -f \"$XDG_RUNTIME_DIR/caffeine-was-enabled\" ]; then dconf write /org/gnome/shell/extensions/caffeine/cli-toggle true; rm -f \"$XDG_RUNTIME_DIR/caffeine-was-enabled\"; fi"]
  },
  {
    "name": "on-screen-black",
    "bus": "session",
    "sender": "org.gnome.ScreenSaver",
    "path": "/org/gnome/ScreenSaver",
    "interface": "org.gnome.ScreenSaver",
    "signal": "ActiveChanged",
    "operator": "==",
    "expected_value": "true",
    "argv": ["logger", "screen faded to black"]
  },
  {
    "name": "suspend-on-display-off",
    "bus": "session",
    "sender": "org.gnome.Mutter.DisplayConfig",
    "interface": "org.gnome.Mutter.DisplayConfig",
    "property": "PowerSaveMode",
    "operator": ">",
    "expected_value": "0",
    "argv": ["systemctl", "--no-block", "suspend"]
  }
]
